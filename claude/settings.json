{
  "agentPushNotifEnabled": true,
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "claude-harness@jtwjs-plugins": true,
    "claude-md-management@claude-plugins-official": true,
    "understand-anything@understand-anything": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "jtwjs-plugins": {
      "source": {
        "repo": "jtwjs/claude-harness",
        "source": "github"
      }
    },
    "karpathy-skills": {
      "source": {
        "repo": "forrestchang/andrej-karpathy-skills",
        "source": "github"
      }
    },
    "understand-anything": {
      "source": {
        "repo": "Lum1104/Understand-Anything",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Glass.aiff -v 6.0",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "ccstatusline --hook",
            "type": "command"
          }
        ],
        "matcher": "Skill"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "afplay /System/Library/Sounds/Funk.aiff -v 6.0",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "ccstatusline --hook",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "inputNeededNotifEnabled": true,
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(pnpm format:*)",
      "Bash(pnpm lint:*)",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Bash(git commit:*)",
      "Bash(python3 -c ':*)",
      "Bash(git remote get-url origin)",
      "Bash(git remote *)",
      "Bash(git worktree *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git fetch *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh search *)",
      "Bash(gh auth status:*)",
      "Bash(git log *)",
      "Bash(git config *)",
      "Bash(git rev-parse *)",
      "Bash(date *)",
      "Bash(mkdir *)",
      "Bash(mkdir -p *)",
      "Bash(printf *)",
      "Bash(grep *)",
      "Bash(cat __HOME__/.config/claude-briefing/*)"
    ]
  },
  "statusLine": {
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10,
    "type": "command"
  },
  "tui": "fullscreen"
}
